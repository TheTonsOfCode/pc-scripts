#!/usr/bin/env bash

set -euo pipefail

TARGET_USER="${1:-Toolkit3D}"
TARGET_ROOT="${2:-/Users/Toolkit3D/dev}"

TMP_FILE="$(mktemp)"
EXCLUDE_FILE="$(mktemp)"
SORTED_FILE="$(mktemp)"

trap 'rm -f "$TMP_FILE" "$EXCLUDE_FILE" "$SORTED_FILE"' EXIT

# PID-y, których nie wolno zabić
printf "%s\n" "$$" >"$EXCLUDE_FILE"
current_parent="${PPID}"
while [[ -n "${current_parent}" && "${current_parent}" -gt 1 ]]; do
    printf "%s\n" "${current_parent}" >>"$EXCLUDE_FILE"
    next_parent="$(ps -o ppid= -p "${current_parent}" 2>/dev/null | tr -d '[:space:]')"
    [[ -z "${next_parent}" ]] && break
    current_parent="${next_parent}"
done

add_candidate() {
    local pid="$1"
    local cmd="$2"

    [[ -z "${pid}" ]] && return 0
    grep -qx "${pid}" "$EXCLUDE_FILE" && return 0

    if ! awk -v pid="$pid" '$1==pid {found=1} END {exit found?0:1}' "$TMP_FILE" 2>/dev/null; then
        printf "%s\t%s\n" "$pid" "${cmd:-unknown}" >>"$TMP_FILE"
    fi
}

USER_UID="$(id -u "${TARGET_USER}")"

run_ps() {
    # 🔥 NIE używamy launchctl → powoduje "Operation not permitted"
    ps -axo pid=,ppid=,user=,command=
}

# 🔍 SZYBKA metoda — command line
while IFS= read -r line; do
    pid="$(awk '{print $1}' <<<"$line")"
    user="$(awk '{print $3}' <<<"$line")"
    cmd="$(cut -d' ' -f4- <<<"$line")"

    if [[ "$user" == "$TARGET_USER" && "$cmd" == *"$TARGET_ROOT"* ]]; then
        add_candidate "$pid" "$cmd"
    fi
done < <(run_ps)

# 🔍 LEKKI fallback (bez +D bo to zabija wydajność)
while IFS= read -r pid; do
    cmd="$(ps -o command= -p "$pid" 2>/dev/null || echo unknown)"
    add_candidate "$pid" "$cmd"
done < <(pgrep -u "$TARGET_USER" 2>/dev/null || true)

if [[ ! -s "$TMP_FILE" ]]; then
    echo "Brak procesow usera '${TARGET_USER}' powiazanych z '${TARGET_ROOT}'."
    exit 0
fi

echo "Znalezione procesy do ewentualnego ubicia:"
printf "%-8s %-8s %s\n" "PID" "PPID" "COMMAND"

sort -n "$TMP_FILE" >"$SORTED_FILE"

while IFS=$'\t' read -r pid cmd; do
    ppid="$(ps -o ppid= -p "${pid}" 2>/dev/null | tr -d '[:space:]' || true)"
    printf "%-8s %-8s %s\n" "${pid}" "${ppid:-?}" "${cmd}"
done <"$SORTED_FILE"

read -r -p "Ubic te procesy? [y/N]: " answer
case "${answer}" in
    y|Y|yes|YES)
        echo "Wysylam SIGTERM..."
        while IFS=$'\t' read -r pid _; do
            kill "${pid}" 2>/dev/null || true
        done <"$SORTED_FILE"

        sleep 1

        echo "Sprawdzam co jeszcze zyje..."
        while IFS=$'\t' read -r pid _; do
            if ps -p "${pid}" >/dev/null 2>&1; then
                kill -9 "${pid}" 2>/dev/null || true
            fi
        done <"$SORTED_FILE"

        echo "Gotowe."
        ;;
    *)
        echo "Anulowano."
        ;;
esac